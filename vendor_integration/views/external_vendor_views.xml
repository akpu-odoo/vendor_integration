<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_list_external_vendor" model="ir.ui.view">
        <field name="name">external.vendor.list</field>
        <field name="model">external.vendor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="authentcation_method_id"/>
                <field name="base_url"/>
            </list>
        </field>
    </record>

    <record id="view_form_external_vendor" model="ir.ui.view">
        <field name="name">external.vendor.form</field>
        <field name="model">external.vendor</field>
        <field name="arch" type="xml">
            <form string="External Vendor">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Acme Supplies"/></h1>
                    </div>
                    <group>
                        <field name="authentcation_method_id"/>
                        <field name="base_url" placeholder="https://api.example.com"/>
                        <field name="currency_id" />
                    </group>
                    <notebook>
                        <page string="APIs">
                            <field name="vendor_api_ids" context="{'default_external_vendor_id': id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="api_method"/>
                                    <field name="api_url"/>
                                    <field name="res_model_id"/>
                                    <field name="api_purpose"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_external_vendor" model="ir.actions.act_window">
        <field name="name">External Vendors</field>
        <field name="res_model">external.vendor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
