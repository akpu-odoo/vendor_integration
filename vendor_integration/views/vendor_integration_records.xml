<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_integration_record_list" model="ir.ui.view">
        <field name="name">vendor.integration.record.list</field>
        <field name="model">vendor.integration.record</field>
        <field name="arch" type="xml">
            <list>
                <field name="vendor_api_id"/>
                <field name="res_model_id"/>
                <field name="external_id"/>
                <field name="res_id"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_integration_record_form" model="ir.ui.view">
        <field name="name">vendor.integration.record.form</field>
        <field name="model">vendor.integration.record</field>
        <field name="arch" type="xml">
            <form string="Vendor Integration Record">
                <sheet>
                    <group>
                        <group>
                            <field name="vendor_api_id"/>
                            <field name="res_model_id"/>
                        </group>
                        <group>
                            <field name="external_id"/>
                            <field name="res_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vendor_integration_records" model="ir.actions.act_window">
        <field name="name">Vendor APIs Records</field>
        <field name="res_model">vendor.integration.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
