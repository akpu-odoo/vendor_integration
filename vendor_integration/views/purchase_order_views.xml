<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_vendor_integration" model="ir.ui.view">
        <field name="name">purchase.order.form.vendor.integration</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="source_api_id" domain="[('is_api_ready', '=', True)]" readonly="state not in ('draft', 'sent')"/>
            </xpath>
        </field>
    </record>
</odoo>
