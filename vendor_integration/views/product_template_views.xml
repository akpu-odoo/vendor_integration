<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_vendor_integration" model="ir.ui.view">
        <field name="name">product.template.form.vendor.integration</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Vendor Integration">
                    <field name="source_api_id" domain="[('is_api_ready', '=', True)]"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
