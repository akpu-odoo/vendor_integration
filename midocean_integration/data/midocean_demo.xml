<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="auth_midocean_demo" model="base.auth">
        <field name="name">MiDocean Demo Connection</field>
        <field name="base_url">https://api.midocean.com</field>
        <field name="auth_type">none</field>
    </record>
    <record id="vendor_midocean" model="external.vendor">
        <field name="name">MiDocean</field>
        <field name="authentication_method_id" ref="auth_midocean_demo" />
        <field name="base_url">https://api.midocean.com</field>
        <field name="currency_id" ref="base.EUR" />
    </record>
    <record id="api_midocean_catalogue" model="vendor.api">
        <field name="name">MiDocean Catalogue</field>
        <field name="external_vendor_id" ref="vendor_midocean" />
        <field name="api_url">/gateway/products/2.0?language=en</field>
        <field name="integration_type">midocean</field>
        <field name="api_purpose">catalogue</field>
        <field name="res_model_id" ref="product.model_product_template" />
        <field name="resolved_path"></field>
        <field name="external_key_path">master_id</field>
        <field name="sync_batch_size">500</field>
    </record>
    <record id="api_midocean_stock" model="vendor.api">
        <field name="name">MiDocean Stock</field>
        <field name="external_vendor_id" ref="vendor_midocean" />
        <field name="api_url">/gateway/stock/2.0</field>
        <field name="integration_type">midocean</field>
        <field name="api_purpose">stock</field>
        <field name="res_model_id" ref="vendor_integration.model_vendor_product_stock" />
        <field name="resolved_path">stock</field>
        <field name="external_key_path">sku</field>
        <field name="sync_batch_size">10000</field>
        <field name="depends_on_api_ids" eval="[(4, ref('api_midocean_catalogue'))]" />
    </record>
    <record id="api_midocean_supplier_price" model="vendor.api">
        <field name="name">MiDocean Supplier Price</field>
        <field name="external_vendor_id" ref="vendor_midocean" />
        <field name="api_url">/gateway/pricelist/2.0</field>
        <field name="integration_type">midocean</field>
        <field name="api_purpose">supplier_price</field>
        <field name="res_model_id" ref="product.model_product_supplierinfo" />
        <field name="resolved_path">price</field>
        <field name="external_key_path">sku</field>
        <field name="sync_batch_size">1000</field>
        <field name="depends_on_api_ids" eval="[(4, ref('api_midocean_catalogue'))]" />
    </record>
    <record id="api_midocean_print_data" model="vendor.api">
        <field name="name">MiDocean Print Data</field>
        <field name="external_vendor_id" ref="vendor_midocean" />
        <field name="api_url">/gateway/printdata/1.0</field>
        <field name="integration_type">midocean</field>
        <field name="api_purpose">print_data</field>
        <field name="res_model_id" ref="model_midocean_print_product" />
        <field name="external_key_path">master_code</field>
        <field name="sync_batch_size">1000</field>
        <field name="depends_on_api_ids" eval="[(4, ref('api_midocean_catalogue'))]" />
    </record>
    <record id="api_midocean_print_pricelist" model="vendor.api">
        <field name="name">MiDocean Print Pricelist</field>
        <field name="external_vendor_id" ref="vendor_midocean" />
        <field name="api_url">/gateway/printpricelist/2.0</field>
        <field name="integration_type">midocean</field>
        <field name="api_purpose">print_pricelist</field>
        <field name="res_model_id" ref="model_midocean_print_pricelist" />
        <field name="external_key_path">id</field>
        <field name="sync_batch_size">1000</field>
        <field name="depends_on_api_ids" eval="[(4, ref('api_midocean_print_data'))]" />
    </record>
    <record id="map_catalogue_name" model="field.mapping">
        <field name="vendor_api_id" ref="api_midocean_catalogue" />
