<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_midocean_vendor_apis" model="ir.actions.act_window">
        <field name="name">MiDocean APIs</field>
        <field name="res_model">vendor.api</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('integration_type', '=', 'midocean')]</field>
    </record>
    <record id="action_midocean_products" model="ir.actions.act_window">
        <field name="name">MiDocean Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('midocean_vendor_id', '!=', False)]</field>
    </record>
    <record id="action_midocean_purchase_orders" model="ir.actions.act_window">
        <field name="name">MiDocean Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_id.external_vendor_id', '!=', False)]</field>
    </record>
    <menuitem id="menu_midocean_root" name="MiDocean"
        parent="vendor_integration.menu_vendor_integration_root" sequence="40"
        groups="base.group_system" />
    <menuitem id="menu_midocean_vendor_apis" name="APIs" parent="menu_midocean_root"
        action="action_midocean_vendor_apis" sequence="10" groups="base.group_system" />
    <menuitem id="menu_midocean_products" name="Products" parent="menu_midocean_root"
        action="action_midocean_products" sequence="20" groups="base.group_system" />
    <menuitem id="menu_midocean_purchase_orders" name="Purchase Orders" parent="menu_midocean_root"
        action="action_midocean_purchase_orders" sequence="30" groups="base.group_system" />
</odoo>