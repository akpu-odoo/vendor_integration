<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_midocean_print_pricelist_form" model="ir.ui.view">
        <field name="name">midocean.print.pricelist.form</field>
        <field name="model">midocean.print.pricelist</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="vendor_id" />
                        <field name="currency_id" />
                        <field name="valid_from" />
                        <field name="valid_until" />
                    </group>
                    <notebook>
                        <page string="Manipulations">
                            <field name="manipulation_ids" readonly="1">
                                <list>
                                    <field name="code" />
                                    <field name="price" />
                                </list>
                            </field>
                        </page>
                        <page string="Techniques">
                            <field name="technique_ids" readonly="1">
                                <list>
                                    <field name="code" />
                                    <field name="pricing_type" />
                                    <field name="setup" />
                                    <field name="setup_repeat" />
                                    <field name="next_colour_cost_indicator" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_midocean_print_pricelist_list" model="ir.ui.view">
        <field name="name">midocean.print.pricelist.list</field>
        <field name="model">midocean.print.pricelist</field>
        <field name="arch" type="xml">
            <list>
                <field name="vendor_id" />
                <field name="currency_id" />
                <field name="valid_from" />
                <field name="valid_until" />
            </list>
        </field>
    </record>
    <record id="action_midocean_print_pricelists" model="ir.actions.act_window">
        <field name="name">MiDocean Print Pricelists</field>
        <field name="res_model">midocean.print.pricelist</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_midocean_print_pricelists" name="Print Pricelists"
        parent="menu_midocean_root" action="action_midocean_print_pricelists" sequence="60"
        groups="base.group_system" />
</odoo>
