<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_base_auth_list" model="ir.ui.view">
        <field name="name">base.auth.list</field>
        <field name="model">base.auth</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="auth_type" />
                <field name="base_url" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="view_base_auth_form" model="ir.ui.view">
        <field name="name">base.auth.form</field>
        <field name="model">base.auth</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="e.g. Production API" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1" />
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="base_url" placeholder="https://api.example.com" />
                            <field name="auth_type" widget="radio" />
                        </group>
                        <group>
                            <field name="timeout" />
                            <field name="verify_ssl" />
                            <field name="follow_redirects" />
                            <field name="success_path" groups="base.group_no_one" />
                            <field name="error_path" groups="base.group_no_one" />
                        </group>
                    </group>
                    <group string="API Key" invisible="auth_type != 'api_key'" name="auth_api_key">
                        <field name="api_key_name" required="auth_type == 'api_key'"
                            placeholder="X-API-Key" />
                        <field name="api_key_in" required="auth_type == 'api_key'" />
                        <field name="api_key" password="True" required="auth_type == 'api_key'" />
                    </group>
                    <group string="Bearer Token" invisible="auth_type != 'bearer'"
                        name="auth_bearer">
                        <field name="bearer_token" password="True" required="auth_type == 'bearer'" />
                    </group>
                    <group string="Basic Auth" invisible="auth_type != 'basic'" name="auth_basic">
                        <field name="username" required="auth_type == 'basic'" />
                        <field name="password" password="True" required="auth_type == 'basic'" />
                    </group>
                    <group string="OAuth 2.0" invisible="auth_type != 'oauth2'" name="auth_oauth2">
                        <field name="grant_type" required="auth_type == 'oauth2'" />
                        <field name="client_id" required="auth_type == 'oauth2'" />
                        <field name="client_secret" password="True" required="auth_type == 'oauth2'" />
                        <field name="token_endpoint" required="auth_type == 'oauth2'"
                            placeholder="https://example.com/oauth/token" />
                        <field name="auth_endpoint"
                            placeholder="https://example.com/oauth/authorize" />
                        <field name="scope" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_base_auth_search" model="ir.ui.view">
        <field name="name">base.auth.search</field>
        <field name="model">base.auth</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="base_url" />
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]" />
                <separator />
                <filter string="API Key" name="type_api_key"
                    domain="[('auth_type', '=', 'api_key')]" />
                <filter string="Bearer" name="type_bearer" domain="[('auth_type', '=', 'bearer')]" />
                <filter string="Basic" name="type_basic" domain="[('auth_type', '=', 'basic')]" />
                <filter string="OAuth 2.0" name="type_oauth2"
                    domain="[('auth_type', '=', 'oauth2')]" />
            </search>
        </field>
    </record>

    <record id="action_base_auth" model="ir.actions.act_window">
        <field name="name">Auth Connections</field>
        <field name="res_model">base.auth</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>